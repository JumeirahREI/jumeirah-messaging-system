# Database connection (libSQL).
# Dev: local SQLite file — no auth token needed.
# Prod (Turso): libsql://your-db.turso.io + TURSO_AUTH_TOKEN below.
TURSO_DATABASE_URL=file:./dev.db
# TURSO_AUTH_TOKEN=your-turso-auth-token

# NextAuth.js (Auth.js v5) signing secret (any long random string, >= 32 chars)
AUTH_SECRET=change-me-to-a-long-random-string
# AUTH_URL=https://your-site.netlify.app  # production base URL

# SMS Gateway — Alawaeltec (AlawaelSmsGateway).
# When ALAWAEL_ORG_NAME + ALAWAEL_USERNAME + ALAWAEL_PASSWORD are all set,
# getSmsGateway() returns AlawaelSmsGateway (real provider). Otherwise it
# falls back to FakeSmsGateway (dev/logs to console).
# ALAWAEL_ORG_NAME=
# ALAWAEL_USERNAME=
# ALAWAEL_PASSWORD=
# ALAWAEL_SEND_URL=https://sms.alawaeltec.com/MainServlet
# ALAWAEL_BALANCE_URL=https://your-https-balance-endpoint
# ALAWAEL_CODING=2

# FakeSmsGateway simulated failure rate (0-1). Dev only.
# SMS_FAIL_RATE=0

# Public site URL, used for Server Actions allowed origins. A full URL or a bare
# host both work; protocol and path are stripped. Defaults to localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Netlify background function auth — shared secret between Next.js server
# and the process-batch-background function. MANDATORY in production: when
# unset, the function and the /api/batches/[id]/process bearer path reject
# every request. Generate a long random string.
# NETLIFY_FUNCTION_SECRET=

# Trust the X-Forwarded-Host header (Auth.js). Set to true behind Netlify/proxies.
# AUTH_TRUST_HOST=true

# Allow the fake SMS gateway outside development (never set in production).
# SMS_ALLOW_FAKE=

# SMS gateway timeouts in milliseconds.
# ALAWAEL_CONNECT_TIMEOUT_MS=8000
# ALAWAEL_SEND_TIMEOUT_MS=40000

# Batch processing tuning.
# PROCESS_TIME_BUDGET_MS=   # max run time of one processing invocation
# SEND_CONCURRENCY=         # parallel sends per invocation
# SEND_CONCURRENCY_MAX=     # upper bound for SEND_CONCURRENCY
# CHAIN_MAX_HOPS=           # max self-chained invocations per batch
# LEASE_TTL_MS=             # how long a processing lease is held
# APP_URL=                  # base URL used to chain background invocations

# Upstash Redis (rate limiting). Required in production for rate limiting.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Database seed script — admin credentials.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=  (required when running db:seed)

# Sentry — DSN shared by all runtimes (client/server/edge).
# Public DSN (browser): NEXT_PUBLIC_SENTRY_DSN. Server/edge: SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# Session replay sample rates (0-1). Sessions default to 0, errors to 1.
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_RATE=1
# Source map upload (build-time only). Create at sentry.io Account Settings > Auth Tokens.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
